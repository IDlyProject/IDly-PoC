# OpenAI API (메일 분석, 선택). 비우면 규칙만으로 분석한다
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# 메일 앱 비밀번호 암호화 키 (Fernet). 비우면 data/secret.key를 만들어 쓴다
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
IDLY_SECRET_KEY=

# Supabase PostgreSQL. IPv4 환경이면 Session pooler 주소를 쓴다. 비우면 data/idly.db(SQLite)
DATABASE_URL=

# 1이면 보고서에 에이전트 체험용 '데모 서비스' 계정이 나온다 (로그인 → 탈퇴까지 원격 화면으로 해볼 수 있음)
IDLY_DEMO=

# Render 배포 시 (프론트는 Vercel이 /api를 이 서버로 리라이트한다)
# IDLY_SELF_URL=https://idly-poc.onrender.com
# FORWARDED_ALLOW_IPS=*   # 프록시 뒤에서 https 주소를 인식하게 (uvicorn이 읽음)

# 기본값을 바꿀 때만
# IDLY_SELF_URL=http://127.0.0.1:47821
# ALLOWED_HOSTS=127.0.0.1,localhost
